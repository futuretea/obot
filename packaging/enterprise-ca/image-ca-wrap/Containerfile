# syntax=docker/dockerfile:1.7

ARG BASE_IMAGE
FROM ${BASE_IMAGE} AS ca

ARG FINAL_USER=root

USER root
COPY .build/enterprise-ca.crt /usr/local/share/ca-certificates/enterprise-ca.crt
RUN set -eux; \
    cert=/usr/local/share/ca-certificates/enterprise-ca.crt; \
    bundle=/etc/ssl/certs/ca-certificates.crt; \
    mkdir -p /etc/ssl/certs /usr/local/share/ca-certificates; \
    if command -v update-ca-certificates >/dev/null 2>&1; then \
        update-ca-certificates; \
    elif command -v update-ca-trust >/dev/null 2>&1; then \
        update-ca-trust extract; \
    fi; \
    if [ -f "$bundle" ]; then \
        cat "$cert" >> "$bundle"; \
    else \
        cp "$cert" "$bundle"; \
    fi

ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/enterprise-ca.crt

USER ${FINAL_USER}
